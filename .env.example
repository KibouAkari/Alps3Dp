# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# PUBLIC_APP_URL= # Legacy-compatible fallback when APP_URL is not set
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Authentication
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# Mail (Resend is preferred whenever RESEND_API_KEY is set; never commit secrets)
RESEND_API_KEY=
# MAIL_PROVIDER=resend  # Optional: resend or smtp
MAIL_FROM=Alps3Dp <order@alps3dp.ch> # legacy fallback for orders
MAIL_FROM_ORDER=Alps3Dp <order@alps3dp.ch>
MAIL_FROM_ACCOUNT=Alps3Dp <info@alps3dp.ch>
MAIL_FROM_SUPPORT=Alps3Dp <info@alps3dp.ch>
# From addresses are sender identities, not notification recipients. All must use a provider-authorized domain.
# Optional additional operations mailbox; the manager below always receives orders.
# Designated shop manager (coded as an always-included recipient): Alp.Kasemi@alps3Dp.ch
ADMIN_ORDER_EMAIL=Alp.Kasemi@alps3Dp.ch
# Set this only to a real mailbox that accepts replies and contact requests.
MAIL_SUPPORT_EMAIL=info@alps3dp.ch

# SMTP alternative (used only when Resend key is empty or MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Transactional mail uses the exact website logo from /images/logo.jpeg.
# See docs/MAIL_SETUP.md; no custom logo/gradient override is needed.
MAIL_BRAND_NAME=Alps3Dp
MAIL_ACCENT_COLOR=#0369a1
MAIL_FOOTER_TEXT=Alps3Dp · Schweiz


# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional
PAYMENT_PROVIDER=stripe
BLOB_READ_WRITE_TOKEN=

# Initial admin (for seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Strong-Password-2026!
ADMIN_NAME=Alp3D Admin
