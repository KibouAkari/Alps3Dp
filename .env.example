# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Authentication
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# Mail (choose either Resend or SMTP — Resend is used first if RESEND_API_KEY is set)
RESEND_API_KEY=
MAIL_FROM=Alp3D Shop <noreply@example.com>
# Owner/support inbox: receives order + contact notifications and is used as the reply-to address.
ADMIN_ORDER_EMAIL=orders@example.com
MAIL_SUPPORT_EMAIL=support@example.com

# SMTP fallback (used only if RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Mail branding — controls how every transactional/contact e-mail looks.
# See docs/MAIL_SETUP.md for the full setup guide.
MAIL_BRAND_NAME=Alps3Dp
MAIL_LOGO_URL=
MAIL_PRIMARY_COLOR=#0ea5e9
MAIL_ACCENT_COLOR=#0369a1
MAIL_FOOTER_TEXT=Alps3Dp · Handgefertigte 3D-gedruckte Produkte aus der Schweiz


# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional
PAYMENT_PROVIDER=stripe
BLOB_READ_WRITE_TOKEN=

# Initial admin (for seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Strong-Password-2026!
ADMIN_NAME=Alp3D Admin
